# `player layout` is the layout of the rows below the container, and those rows are the menu's own space
# only while the player's inventory is hidden: the client draws that half of the window from the last
# content packet, so a menu that hid it can put buttons there and they are buttons. Asking for the layout
# is asking for the half, so the keyword hides the inventory by itself -- which is what this file holds it
# to, in both places a page can be declared.
#
# The slots the two checks below pin are the first cells below the container of their own page, so they are
# that page's container size: 27 under a three row chest and 9 under a one row one. A layout that landed on
# the container instead would report a smaller number, and one the menu ignored would report nothing.

on load:
    create a phantom menu with chest inventory titled "Player layout" with layout "AAAAA    ", "         ", "         " with player layout "B        ", "         ", "         ", "         " with id "playerlayout" with 0 ms click delay:
        map key "A" to icon apple named "layout-a" for menu with id "playerlayout"
        map key "B" to icon bread named "layout-b" for menu with id "playerlayout"
    set {_menu} to the menu with id "playerlayout"
    if player inventory of {_menu} is hidden:
        log "XIAOJIE_SELFTEST detail: player layout hides the player inventory -> hidden"
    else:
        log "XIAOJIE_SELFTEST detail: player layout FAILED to hide the player inventory -> shown"
    set {_slots::*} to the slots of key "B" in page 1 of {_menu}
    log "XIAOJIE_SELFTEST detail: player layout key slot -> B at %{_slots::*}%"
    destroy the menu {_menu}

# The same keyword on a page inserted later, and on a page whose container is one row rather than three:
# the half belongs to the menu rather than to a page -- the player's inventory is either there or it is not
# -- so a layout declared on page 2 hides it for page 1 too, and the rows it lays out start where that
# page's own container ends.
on load:
    create a phantom menu with chest inventory titled "Inserted layout" with layout "AAAAA    ", "         ", "         " with id "insertlayout":
        set {_menu} to the menu with id "insertlayout"
        insert page with layout "CCCC     " with player layout "D        " with title "Second"
        if player inventory of {_menu} is hidden:
            log "XIAOJIE_SELFTEST detail: insert page player layout hides the inventory -> hidden"
        else:
            log "XIAOJIE_SELFTEST detail: insert page player layout FAILED to hide the inventory -> shown"
        set {_slots::*} to the slots of key "D" in page 2 of {_menu}
        log "XIAOJIE_SELFTEST detail: insert page player layout key slot -> D at %{_slots::*}%"
    destroy the menu with id "insertlayout"

# The two keywords written against each other. `with player layout` is the one that says the half is the
# menu's, so it wins: the inventory is hidden anyway, and Skript prints one line while the script loads
# saying that the `without hide player inventory` next to it was ignored. The line is not asserted here --
# what matters is that the menu came out hidden rather than as neither one thing nor the other.
on load:
    create a phantom menu with chest inventory titled "Conflicting layout" with layout "AAAAA    ", "         ", "         " with player layout "B        " with id "layoutconflict" without hide player inventory:
        set {_unused} to 1
    set {_menu} to the menu with id "layoutconflict"
    if player inventory of {_menu} is hidden:
        log "XIAOJIE_SELFTEST detail: player layout wins over without hide -> hidden"
    else:
        log "XIAOJIE_SELFTEST detail: player layout FAILED to win over without hide -> shown"
    destroy the menu {_menu}

# `show player inventory` cannot take that half back: the page lays it out, and a window that is half the
# page's icons and half the player's items is the one window this addon does not build. So the request is
# refused -- with a line saying what to do instead -- and the menu is left as it was. The pair below is the
# whole of it: the refusal is narrow, and a menu with no player layout still shows its inventory normally.
on load:
    create a phantom menu with chest inventory titled "Refused show" with layout "AAAAA    ", "         ", "         " with player layout "B        " with id "layoutrefuse" with 0 ms click delay:
        set {_unused} to 1
    create a phantom menu with chest inventory titled "Showable" with layout "AAAAA    ", "         ", "         " with id "layoutshowable" with hide player inventory:
        set {_unused} to 1
    set {_menu} to the menu with id "layoutrefuse"
    show player inventory of {_menu}
    if player inventory of {_menu} is hidden:
        log "XIAOJIE_SELFTEST detail: show player inventory refused -> still hidden"
    else:
        log "XIAOJIE_SELFTEST detail: show player inventory FAILED to be refused -> shown"
    destroy the menu {_menu}
    set {_menu} to the menu with id "layoutshowable"
    show player inventory of {_menu}
    if player inventory of {_menu} is hidden:
        log "XIAOJIE_SELFTEST detail: show without a player layout FAILED -> still hidden"
    else:
        log "XIAOJIE_SELFTEST detail: show without a player layout -> shown"
    destroy the menu {_menu}
