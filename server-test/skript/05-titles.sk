# The title-taking statements, covered in the forms Skript actually accepts.
#
# `insert page ... with title` lives inside the create section because that is the only place a page
# belongs to a menu without naming it, and the title of the inserted page is read back: a title that
# lands in the wrong expression slot shows up here as the wrong string.
#
# Each case gets its own `on load` trigger, because Skript aborts only the trigger of a line it cannot
# parse: one broken title form then costs its own detail line instead of hiding the others.
#
# `string:` is a parse tag inside the registered pattern, not text a script writes: Skript's
# ParseTagPatternElement records the tag and matches on, so `to "X"` is what reaches the
# `string:%-string%` pattern. Writing `to string:"X"` leaves `string:"X"` over for the `%-object%`
# pattern, which cannot turn it into a title; the last case below pins that behaviour.
#
# Native assertions check values before the unchanged detail markers are emitted.

on load:
    create a phantom menu with chest inventory titled "Title Menu" with layout "AAAAAAAAA" with id "titles":
        # The line reports what the menu kept, not that the body ran: `created` would be true of a body
        # that ran for a menu the id could not find.
        set {_menu} to the menu with id "titles"
        assert "%the default title of {_menu}%" is "Title Menu" with "titles menu must retain its title"
        assert the inventory type of {_menu} is chest inventory with "titles menu must use chest inventory"
        log "XIAOJIE_SELFTEST detail: create titles menu -> default title %the default title of {_menu}%, type %the inventory type of {_menu}%"
        insert page with layout "BBBBBBBBB" with title "Second"
        set {_count} to the page number of {_menu}
        set {_title} to the title of page 2 in {_menu}
        # Separate assertions avoid relying on compound-condition parsing.
        assert {_count} is 2 with "titled insertion must produce two pages"
        assert "%{_title}%" is "Second" with "inserted page must retain title Second"
        log "XIAOJIE_SELFTEST detail: insert page with title -> %{_count}% page(s), page 2 titled %{_title}%"

on load:
    set {_menu} to the menu with id "titles"
    update title of page 1 in {_menu} to "Renamed"
    set {_title} to the title of page 1 in {_menu}
    assert "%{_title}%" is "Renamed" with "updated page must retain title Renamed"
    log "XIAOJIE_SELFTEST detail: update page title -> %{_title}%"

on load:
    set {_menu} to the menu with id "titles"
    update title of page 1 in {_menu} to string:"Tagged"
    set {_title} to the title of page 1 in {_menu}
    assert "%{_title}%" is "Renamed" with "tagged title form must not change the title"
    log "XIAOJIE_SELFTEST detail: tagged title form changes nothing -> %{_title}%"

on load:
    # Needs a player, which this layer has none of: this statement is here to be parsed, and the unset
    # variable makes it log an error and return, which is the expected outcome.
    turn to page 1 for {_nobody} with title "Ignored"
    log "XIAOJIE_SELFTEST detail: turn page title parses -> parsed"

on load:
    # Needs a menu session, which this layer has none of: this statement is here to be parsed.
    update title of menu session {_nobody} to "Ignored"
    log "XIAOJIE_SELFTEST detail: session title parses -> parsed"

on load:
    set {_menu} to the menu with id "titles"
    # The only write here that goes through the expression's own changer: the `update title ...`
    # statements above go through the effect instead. Page 9 does not exist, so the expression refuses
    # the write and says so on the runtime channel, and the trigger keeps going afterwards because a
    # runtime message does not abort it.
    set the title of page 9 in {_menu} to "Nowhere"
    set {_title} to the title of page 1 in {_menu}
    assert "%{_title}%" is "Renamed" with "refused out of bounds page title must leave page 1 alone"
    log "XIAOJIE_SELFTEST detail: out of bounds page title refused -> %{_title}%"

on load:
    set {_menu} to the menu with id "titles"
    destroy the menu {_menu}
    assert {_menu} is destroyed with "titles menu must be destroyed"
    log "XIAOJIE_SELFTEST detail: destroy titles menu -> done"
