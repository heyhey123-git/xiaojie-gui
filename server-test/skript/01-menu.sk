# Native Skript EffAssert checks run before the existing detail markers. Gradle checks completion
# and diagnostics; a failed assertion stops its trigger without stopping the independent 99-finish timer.
# No player is involved here: this covers registration, parsing and the menu model.

on load:
    create a phantom menu with chest inventory titled "Selftest" with layout "AAAAAAAAA" and "A       A" and "AAAAAAAAA" with id "selftest":
        set {_pages} to the page number of the menu with id "selftest"
        assert {_pages} is 1 with "create phantom chest menu: expected one page"
        log "XIAOJIE_SELFTEST detail: create phantom chest menu -> %{_pages}% page(s)"

on load:
    set {_menu} to the menu with id "selftest"
    assert {_menu} is set with "lookup menu by id: menu must exist"
    assert {_menu} is not destroyed with "fresh menu must not be destroyed"
    # Keep the menu-typed id expression: SkBee's bound-id expression can capture an untyped variable.
    set {_id} to the id of the menu with id "selftest"
    set {_mode} to the mode of {_menu}
    set {_type} to the inventory type of {_menu}
    assert {_id} is "selftest" with "lookup menu by id: expected selftest"
    assert {_mode} is "phantom" with "lookup menu by id: expected phantom mode"
    assert {_type} is chest inventory with "lookup menu by id: expected chest inventory"
    log "XIAOJIE_SELFTEST detail: lookup menu by id -> id %{_id}%, mode %{_mode}%, type %{_type}%"
    assert the mode of {_menu} is "phantom" with "menu mode must be text"
    log "XIAOJIE_SELFTEST detail: menu mode is text -> %{_mode}%"

on load:
    set {_menu} to the menu with id "selftest"
    set {_default} to the default page of {_menu}
    set the default page of {_menu} to 1
    set {_delay} to the minimum click delay of {_menu}
    set {_viewers::*} to the menu viewers of {_menu}
    assert {_default} is 1 with "menu defaults: expected page 1"
    assert the default page of {_menu} is 1 with "default page setter must retain page 1"
    assert {_delay} is 50 with "menu defaults: expected delay 50"
    assert size of {_viewers::*} is 0 with "menu defaults: expected no viewers"
    log "XIAOJIE_SELFTEST detail: menu defaults -> page %{_default}%, delay %{_delay}%, %size of {_viewers::*}% viewer(s)"

on load:
    set {_ids::*} to all menu ids
    set {_menus::*} to all menus
    assert size of {_ids::*} is 1 with "enumerate menus: expected one id"
    assert size of {_menus::*} is 1 with "enumerate menus: expected one menu"
    log "XIAOJIE_SELFTEST detail: enumerate menus -> %size of {_ids::*}% id(s), %size of {_menus::*}% menu(s)"

on load:
    set {_menu} to the menu with id "selftest"
    assert player inventory of {_menu} is not hidden with "default player inventory must be shown"
    log "XIAOJIE_SELFTEST detail: player inventory condition -> shown"

on load:
    set {_menu} to the menu with id "selftest"
    destroy the menu {_menu}
    assert {_menu} is destroyed with "destroy menu must mark it destroyed"
    log "XIAOJIE_SELFTEST detail: destroy menu -> destroyed"
