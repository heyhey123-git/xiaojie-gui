# Kept apart from 01-menu.sk so a rejected creation pattern does not hide the other menu checks.

on load:
    create a static menu with hopper inventory titled "StaticSelftest" with layout "AAAAA" with id "static_selftest" with 250 ms click delay without hide player inventory:
        set {_pages} to the page number of the menu with id "static_selftest"
        set {_mode} to the mode of the menu with id "static_selftest"
        assert {_pages} is 1 with "static hopper must have one page"
        assert {_mode} is "static" with "static hopper must retain static mode"
        log "XIAOJIE_SELFTEST detail: create static hopper menu -> %{_pages}% page(s), mode %{_mode}%"
    set {_menu} to the menu with id "static_selftest"
    destroy the menu {_menu}

on load:
    create a phantom menu with chest inventory titled "HideSelftest" with layout "A" with id "hide_selftest" with hide player inventory:
        set {_menu} to the menu with id "hide_selftest"
        assert "%the default title of {_menu}%" is "HideSelftest" with "hidden menu must retain its title"
        assert the inventory type of {_menu} is chest inventory with "hidden menu must use chest inventory"
        log "XIAOJIE_SELFTEST detail: create menu hiding the player inventory -> default title %the default title of {_menu}%, type %the inventory type of {_menu}%"
    set {_menu} to the menu with id "hide_selftest"
    assert player inventory of {_menu} is hidden with "hide flag must take effect"
    log "XIAOJIE_SELFTEST detail: hide flag took effect -> hidden"
    destroy the menu {_menu}

# A static window always shows the player's own inventory, so `with hide player inventory` has nothing to
# change there: the addon says so instead of ignoring the keyword in silence, and the gate pins that
# warning, so this block only has to create the menu and check that the keyword did not break creation.
on load:
    create a static menu with chest inventory titled "StaticHide" with layout "A" with id "static_hide" with hide player inventory:
        set {_unused} to 1
    assert the menu with id "static_hide" is set with "static menu with the hide flag must still be created"
    log "XIAOJIE_SELFTEST detail: static hide flag is a no-op -> created"
    destroy the menu with id "static_hide"

# The same promise for the runtime door: `hide player inventory of %menu%` on a static menu says it does
# nothing there, exactly as the creation-time keyword does. The flag is still set, which the assertion below
# checks -- what the warning stops is a script believing the window changed.
on load:
    create a static menu with chest inventory titled "StaticHideEffect" with layout "A" with id "static_hide_effect" with 0 ms click delay
on load:
    set {_menu} to the menu with id "static_hide_effect"
    hide player inventory of {_menu}
    assert {_menu} is set with "static menu must survive the runtime hide"
    assert player inventory of {_menu} is hidden with "the runtime hide flag must still be set"
    log "XIAOJIE_SELFTEST detail: static hide effect is a no-op -> warned"
    destroy the menu with id "static_hide_effect"

# A phantom window cannot move anything, so `with locked icons` has nothing to protect there. Same promise as
# the static-hide block above: the keyword is reported once instead of doing nothing in silence, and the gate
# pins that line.
on load:
    create a phantom menu with chest inventory titled "PhantomLocked" with layout "A" with id "phantom_locked" with 0 ms click delay with locked icons:
        set {_unused} to 1
    assert the menu with id "phantom_locked" is set with "phantom menu with the lock flag must still be created"
    log "XIAOJIE_SELFTEST detail: phantom locked icons is a no-op -> created"
    destroy the menu with id "phantom_locked"

# An unsupported container is a script author's mistake, so it gets one line on the runtime channel and
# nothing is created: the gate requires that line, and `is not set` proves no half-built menu was left.
on load:
    create a phantom menu with crafting table inventory titled "Unsupported" with layout "AAA" with id "unsupported_type" with 0 ms click delay
    assert the menu with id "unsupported_type" is not set with "unsupported container must not create a menu"
    log "XIAOJIE_SELFTEST detail: unsupported container refused -> not created"

# The merchant layout exists, so creation succeeds; the window is what Bukkit cannot build. The guard runs
# before the player is read, which is why an unset player is enough to reach it here.
on load:
    create a static menu with merchant inventory titled "MerchantSelftest" with layout "AAA" with id "merchant_selftest" with 0 ms click delay
on load:
    set {_menu} to the menu with id "merchant_selftest"
    assert {_menu} is set with "merchant menu must still be creatable"
    open menu {_menu} for {_nobody}
    log "XIAOJIE_SELFTEST detail: static merchant refused -> not opened"
