on load:
    create a phantom menu with dispenser inventory titled "Dispenser" with layout "AAAAAAAAA" with id "type_dispenser":
        set {_pages} to the page number of the menu with id "type_dispenser"
        assert {_pages} is 1 with "dispenser inventory must create one page"
        log "XIAOJIE_SELFTEST detail: inventory type dispenser -> %{_pages}% page(s)"
    set {_menu} to the menu with id "type_dispenser"
    destroy the menu {_menu}
